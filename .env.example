# Copy to .env and fill in. .env is gitignored and must never be committed.

# Where large external corpora are cached (Dakshina, MIDV, Wikidata dumps).
# Point this OUTSIDE the repo if disk is tight.
KYC_NLI_DATA_DIR=./data

# HuggingFace token, only needed for gated models. Leave blank otherwise.
HF_TOKEN=

# Optional experiment tracking. Leave blank to log to local CSV only.
WANDB_API_KEY=
WANDB_PROJECT=kyc-nli
